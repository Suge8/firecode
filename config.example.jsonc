{
	// Recommended config: every feature on. It is written here on first launch; swap in the models you are logged in to, then restart Pi.
	// The watcher does not activate itself in a new session; run /fire-watch to toggle it for the current session.
	// Everywhere a model is named, use a model atom "model/thinking"; the provider is optional. An ordered array chooses alternatives.
	// Language of the UI and of the text shown to models: follows the system locale by default (zh* → Chinese, otherwise English); uncomment the next line to pin it, "zh" | "en".
	// "language": "en",
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"stats": true,
		"claudeSub": true,
		"claudeFiles": true,
		"openaiNative": true,
		"review": true,
		"master": true,
		"watcher": true
	},

	"keys": {
		"fast": "ctrl+shift+s"
	},

	// nativeCompaction uses OpenAI's native context compaction. The result can only be continued by the same model and base URL:
	// unavailable windows stop requests and compaction without dropping history. Re-enable this option and switch back to resume.
	// Failures fall back to normal summaries only before the first native checkpoint. Set false for new sessions to use normal summaries.
	// priority pays more for faster output and is off by default.
	"openai": {
		"nativeCompaction": true,
		"providers": {
			"openai-codex": { "textVerbosity": "low", "priority": false }
		}
	},

	// New sessions activate the Master by default. Role names are yours to choose; the Master picks a role by its "use".
	// Sub-agents, reviewers and the watcher only find models from Pi's built-in providers or models.json, not from other extensions' providers.
	"master": {
		"autoActivate": true,
		"workerExcludeExtensions": [],
		"roles": {
			"engineer": { "model": ["claude-opus-5-5/medium", "gpt-6-astra/medium"], "use": "Implement and debug substantial code changes" },
			"designer": { "model": ["claude-opus-5-5/high", "gpt-6-astra/high"], "use": "Design and build visual interfaces and interactions" },
			"junior": { "model": ["claude-sonnet-5-5/medium", "gpt-6.1-terra/medium"], "use": "Implement bounded, well-specified small changes" },
			"chores": { "model": ["gpt-6.1-terra/medium", "claude-haiku-5-5/medium"], "use": "Perform routine mechanical maintenance and bulk edits" },
			"researcher": { "model": ["gpt-6.1-terra/high", "claude-sonnet-5-5/medium"], "use": "Investigate sources, documentation and code without editing" },
			"sentinel": { "model": ["gpt-6-luna/high", "claude-haiku-5-5/medium"], "use": "Monitor CI, deployments and long-running processes until completion" }
		}
	},

	"presets": {
		"sonnet": { "model": "anthropic/claude-sonnet-5-5/high", "key": "alt+1" },
		"opus": { "model": "anthropic/claude-opus-5-5/high", "key": "alt+2" },
		"fable": { "model": "anthropic/claude-fable-5-1/medium", "key": "alt+3" },
		"astra": { "model": "openai-codex/gpt-6-astra/medium", "key": "alt+4" },
		"sol": { "model": "openai-codex/gpt-6.1-sol/medium", "key": "alt+5" },
		"ds": { "model": "deepseek/deepseek-flash/high", "key": "alt+6" }
	},

	// Review only calls models when the user or the Master starts it.
	// A pass needs a PASS from every reviewer; a model failure tries the next candidate in its chain.
	"review": {
		"advisor": ["claude-opus-5-5/high", "gpt-6-astra/high"],
		"reviewers": [["gpt-6.1-terra/low", "claude-sonnet-5-5/low"]],
		"maxRounds": 5,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 40,
		"tools": ["read", "grep", "find", "ls", "bash"]
	},

	// Once active, it evaluates what each main-session turn added, which costs extra model calls; it speaks up on the spot when needed.
	"watcher": {
		"enabled": false,
		"model": ["gpt-6.1-terra/medium", "claude-haiku-5-5/medium"],
		"context": "minimal"
	}
}
