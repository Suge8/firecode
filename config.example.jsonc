{
	// Recommended config: every feature on. It is written here on first launch; swap in the models you are logged in to, then restart Pi.
	// Everywhere a model is named, use a model atom "model/thinking"; the provider is optional. An ordered array chooses alternatives.
	// Language of the UI and of the text shown to models: follows the system locale by default (zh* → Chinese, otherwise English); uncomment the next line to pin it, "zh" | "en".
	// "language": "en",
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"stats": true,
		"claudeSub": true,
		"claudeFiles": true,
		"openaiNative": true,
		"review": true,
		"master": true
	},

	"keys": {
		"fast": "ctrl+shift+s"
	},

	// nativeCompaction uses OpenAI's native context compaction. The result can only be continued by the same model and base URL:
	// unavailable windows stop requests and compaction without dropping history. Re-enable this option and switch back to resume.
	// Failures fall back to normal summaries only before the first native checkpoint. Set false for new sessions to use normal summaries.
	// priority pays more for faster output and is off by default.
	"openai": {
		"nativeCompaction": true,
		"providers": {
			"openai-codex": { "textVerbosity": "low", "priority": false }
		}
	},

	// One cheap model chain for background work, separate from roles and review. It is the only model used for:
	// - the one line saying what each running sub-agent is doing (activity list and sub-agent view, never sent to the Master):
	//   first after 30 seconds of running, then at most every 2 minutes and only with new output; about 4k tokens in, 30 out;
	// - every compaction summary, automatic or /compact, in the main session and in sub-agents (instead of the session model).
	//   A candidate whose context window cannot hold the conversation is skipped; if the whole chain fails, Pi's default compaction runs;
	// - idleCompaction: when a session sits idle past the 1-hour prompt cache, the next request starts from a summary prepared in advance
	//   instead of re-sending 150k+ tokens uncached.
	// Haiku comes first: in replays of real sessions its summaries kept more of the details used later (46% vs 33% for Luna).
	// GPT-only: ["gpt-6-luna/low"]. Claude-only: ["claude-haiku-5-5/low"]. Remove the whole section to turn all three off.
	"background": {
		"model": ["claude-haiku-5-5/low", "gpt-6-luna/low"],
		"idleCompaction": true
	},

	// New sessions activate the Master by default. Role names are yours to choose; the Master picks a role by its "use".
	// Sub-agents and reviewers only find models from Pi's built-in providers or models.json, not from other extensions' providers.
	"master": {
		"autoActivate": true,
		"workerExcludeExtensions": [],
		"roles": {
			"engineer": { "model": ["claude-opus-5-5/medium", "gpt-6-astra/medium"], "use": "Hard problems: cross-module invariants, concurrency, persistence, security, debugging with an unknown root cause, final integration; also audits that need deep code reading (read-only)" },
			"designer": { "model": ["claude-opus-5-5/high", "gpt-6-astra/high"], "use": "Visual and frontend work" },
			"junior": { "model": ["claude-sonnet-5-5/medium", "gpt-6.1-terra/medium"], "use": "Ordinary implementation with clear requirements and acceptance, local fixes, and multi-file changes following existing patterns; escalates product or architecture trade-offs" },
			"chores": { "model": ["gpt-6.1-terra/medium", "claude-haiku-5-5/medium"], "use": "Mechanical work with a clear spec, verifiable by tests or type checks: renames, pattern migrations, boilerplate, scripts and running commands; prefers a deterministic script and does one sample first" },
			"researcher": { "model": ["gpt-6.1-terra/high", "claude-sonnet-5-5/medium"], "use": "Read-only research: web search, docs and version lookups, reading long logs and traces, locating code, organizing data; returns conclusions with sources" },
			"sentinel": { "model": ["gpt-6-luna/high", "claude-haiku-5-5/medium"], "use": "Waiting on CI, deployments and long tests" }
		}
	},

	// Review only calls models when the user or the Master starts it.
	// A pass needs a PASS from every reviewer; a model failure tries the next candidate in its chain.
	// A verdict from a later candidate is marked "fallback" on the card and in the Master event: fallback reviewers miss far more defects.
	// The Claude tail is the reviewer for Claude-only subscriptions; Opus low finds about twice what Sonnet low does.
	"review": {
		"advisor": ["claude-opus-5-5/high", "gpt-6-astra/high"],
		"reviewers": [["gpt-6.1-terra/low", "claude-opus-5-5/low"]],
		"maxRounds": 3, // two repair rounds get most of the gain; later rounds mostly add noise
		"advisorAfterFailures": 2,
		"timeoutMinutes": 40,
		"tools": ["read", "grep", "find", "ls", "bash"]
	}
}
