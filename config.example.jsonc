{
	// Recommended config: every feature on. It is written here on first launch; swap in the models you are logged in to, then restart Pi.
	// The watcher does not activate itself in a new session; run /fire-watch to toggle it for the current session.
	// Everywhere a model is named, use the same model atom: "provider/model/thinking" (the last segment is the thinking level).
	// Language of the UI and of the text shown to models: follows the system locale by default (zh* → Chinese, otherwise English); uncomment the next line to pin it, "zh" | "en".
	// "language": "en",
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"stats": true,
		"claudeSub": true,
		"claudeFiles": true,
		"openaiNative": true,
		"review": true,
		"master": true,
		"watcher": true
	},

	"keys": {
		"fast": "ctrl+shift+s"
	},

	// nativeCompaction uses OpenAI's native context compaction. The result can only be continued by the same model and base URL:
	// after a model switch a manual /compact is cancelled with an explanation and automatic compaction falls back to a normal summary.
	// Set it to false to always use normal summaries. priority pays more for faster output and is off by default.
	"openai": {
		"nativeCompaction": true,
		"providers": {
			"openai-codex": { "textVerbosity": "low", "priority": false }
		}
	},

	// New sessions activate the Master by default. Role names are yours to choose; the Master picks a role by its "use".
	// Sub-agents, reviewers and the watcher only find models from Pi's built-in providers or models.json, not from other extensions' providers.
	"master": {
		"autoActivate": true,
		"workerExcludeExtensions": [],
		"roles": {
			"researcher": {
				"model": "anthropic/claude-haiku-5-5/low",
				"use": "Read-only: web search, docs and version lookups, reading logs, locating code from leads, checking references",
				"fallback": ["openai-codex/gpt-6-luna/medium"]
			},
			"engineer": {
				"model": "anthropic/claude-sonnet-5-5/high",
				"use": "Changes code: implementation, debugging; also for audits that need deep code reading to find defects (read-only)",
				"fallback": ["openai-codex/gpt-6.1-sol/high"]
			},
			"batch": {
				"model": "anthropic/claude-haiku-5-5/medium",
				"use": "Well-specified bulk changes that tests or type checks can verify: pattern migrations, renames, boilerplate; for large volumes split by file and run several in parallel",
				"fallback": ["openai-codex/gpt-6.1-sol/medium"]
			},
			"designer": {
				"model": "anthropic/claude-opus-5-5/medium",
				"use": "Visual and frontend work",
				"fallback": ["openai-codex/gpt-6.1-sol/high"]
			},
			"sentinel": {
				"model": "anthropic/claude-haiku-5-5/low",
				"use": "Waiting on CI, deployments and long tests",
				"fallback": ["anthropic/claude-sonnet-5-5/low"]
			}
		}
	},

	"presets": {
		"sonnet": { "model": "anthropic/claude-sonnet-5-5/high", "key": "alt+1" },
		"opus": { "model": "anthropic/claude-opus-5-5/high", "key": "alt+2" },
		"fable": { "model": "anthropic/claude-fable-5-1/medium", "key": "alt+3" },
		"astra": { "model": "openai-codex/gpt-6-astra/medium", "key": "alt+4" },
		"sol": { "model": "openai-codex/gpt-6.1-sol/medium", "key": "alt+5" },
		"ds": { "model": "deepseek/deepseek-flash/high", "key": "alt+6" }
	},

	// Review only calls models when the user or the Master starts it.
	// A pass needs a PASS from every reviewer. A reviewer that gives no verdict (error, expired login, timeout, empty output)
	// is retried along its fallback chain (up to 2 atoms); if the chain runs out, the review stops as failed and names the model and the reason.
	"review": {
		"advisor": "anthropic/claude-fable-5-1/high",
		"reviewers": [
			"anthropic/claude-opus-5-5/low",
			{ "model": "openai-codex/gpt-6.1-sol/low", "fallback": ["anthropic/claude-sonnet-5-5/low"] }
		],
		"maxRounds": 5,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 40,
		"tools": ["read", "grep", "find", "ls", "bash"]
	},

	// Once active, it evaluates what each main-session turn added, which costs extra model calls; it speaks up on the spot when needed.
	"watcher": {
		"enabled": false,
		"model": "openai-codex/gpt-6.1-sol/medium",
		"context": "minimal"
	}
}
