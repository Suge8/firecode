{
	// Copy to the Pi Agent directory at extensions/firecode/config.jsonc, then restart Pi.
	// The template enables only local UI and session conveniences. Turn on provider,
	// notification, review, and delegation features after configuring their requirements.
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"rename": true,
		"stats": true,
		"claudeSub": false,
		"openaiNative": false,
		"workingFlame": true,
		"bark": false,
		"review": false,
		"master": false,
		"watcher": false
	},
	"keys": {
		"rename": "ctrl+r",
		"cyclePreset": "ctrl+shift+u",
		"fast": "ctrl+f"
	},
	"presets": {
		"deep": {
			"thinkingLevel": "high",
			"key": "alt+1"
		}
	},
	// Turning on features.watcher requires this section: model and thinking are mandatory
	// and must resolve in a built-in provider (extension providers do not load in subsessions).
	// "watcher": {
	// 	"enabled": true,      // auto-start in new sessions; /fire-watch off is session-only
	// 	"model": "anthropic/claude-haiku-4-5",
	// 	"thinking": "low",
	// 	"context": "minimal"  // minimal drops reasoning and diff bodies from the increment
	// },
	"master": {
		// 新会话默认注入 subagents；/fire-master off 只关闭当前会话。
		"autoActivate": true,
		// Worker 默认加载全部扩展；这里可按完整路径或文件名排除。
		"workerExcludeExtensions": []
	}
}
