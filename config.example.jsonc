{
	// 公开推荐配置：除 Bark 外功能全开。复制后重启 Pi。
	// Watcher 默认在每个主会话回合后调用模型。
	// 凡是指定模型的位置都写同一个模型原子："provider/model/thinking"，思考档取最后一段。
	"features": {
		"header": true,
		"statusbar": true,
		"tools": true,
		"presets": true,
		"rename": true,
		"stats": true,
		"claudeSub": true,
		"openaiNative": true,
		"workingFlame": true,
		"bark": false,
		"review": true,
		"master": true,
		"watcher": true
	},

	"keys": {
		"rename": "ctrl+r",
		"cyclePreset": "ctrl+shift+u",
		"fast": "ctrl+f"
	},

	// nativeCompaction 使用 OpenAI 原生上下文压缩；priority 加钱换更快出字，默认关。
	"openai": {
		"nativeCompaction": true,
		"providers": {
			"openai-codex": { "textVerbosity": "low", "priority": false },
			"xai": { "priority": false }
		}
	},

	// 每个主会话回合后评估新增内容，会产生额外模型调用；需要开口时当场插话。
	"watcher": {
		"enabled": true,
		"model": "openai-codex/gpt-5.6-sol/low",
		"context": "minimal"
	},

	// 新会话默认激活指挥官。
	"master": {
		"autoActivate": true,
		"workerExcludeExtensions": [],
		"roles": {
			"调研员": {
				"model": "anthropic/claude-sonnet-5/medium",
				"use": "大量搜索、读日志、找线索；不实现",
				"fallback": ["openai-codex/gpt-5.6-luna/high"]
			},
			"工程师": {
				"model": "anthropic/claude-opus-5/medium",
				"use": "实现、调试",
				"fallback": ["openai-codex/gpt-6-astra/low", "anthropic/claude-fable-5-1/low"]
			},
			"设计师": {
				"model": "anthropic/claude-opus-5/medium",
				"use": "视觉、前端",
				"fallback": ["openai-codex/gpt-6-astra/low"]
			},
			"哨兵": {
				"model": "anthropic/claude-sonnet-5/low",
				"use": "CI、部署、长测试等待",
				"fallback": ["openai-codex/gpt-5.6-luna/low"]
			}
		}
	},

	"presets": {
		"fable": { "model": "anthropic/claude-fable-5-1/medium", "key": "alt+1" },
		"opus5": { "model": "anthropic/claude-opus-5/medium", "key": "alt+2" },
		"astra": { "model": "openai-codex/gpt-6-astra/medium", "key": "alt+3" },
		"sol": { "model": "openai-codex/gpt-5.6-sol/medium", "key": "alt+4" },
		"ds": { "model": "deepseek/deepseek-v4-flash-vision-exp/high", "key": "alt+5" },
		"xai": { "model": "xai/grok-4.6/high", "key": "alt+6" }
	},

	// 审查只在用户或指挥官发起时调用模型。
	"review": {
		"advisor": "anthropic/claude-fable-5-1/high",
		"reviewers": ["openai-codex/gpt-6-astra/medium", "anthropic/claude-opus-5/medium"],
		"maxRounds": 5,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 20,
		"tools": ["read", "grep", "find", "ls", "bash"],
		"language": "zh"
	}
}
