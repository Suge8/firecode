---
import logoUrl from "../../../design/brand/logo-dark.svg?url";
import { NPM, REPO, site, type Lang } from "../i18n";
import { copy } from "./Nav.copy";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = site[lang];
const c = copy[lang];
const other = lang === "en" ? "zh-CN" : "en";
---

<header class="nav">
	<a class="brand" href={t.home}><img src={logoUrl} alt="FireCode" height="26" /></a>
	<nav class="links">
		<a href={t.switchHref} hreflang={other}>{t.switchLabel}</a>
		<a href={NPM} aria-label="npm" title="npm">
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"></path></svg>
		</a>
		<a href={REPO} aria-label="GitHub" title="GitHub">
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
		</a>
		<!-- 复制逻辑在 Install 组件里统一处理（data-copy-install），反馈的 aria-live 节点必须紧跟按钮 -->
		<button type="button" class="install" title={t.copy} aria-label={t.copy} data-copy-install data-copied={t.copied}>
			<span class="label">{c.install}</span>
			<span class="label done" aria-hidden="true">{t.copied}</span>
		</button>
		<span class="sr-only" aria-live="polite"></span>
	</nav>
</header>

<script>
	import { ScrollTrigger } from "../scroll";

	// 一离开页顶就垫一层顶部渐隐，免得链接压在火舌和淡出的标题上；滚过大半屏后换成半透明底并露出安装按钮；
	// 往下读时让出视野，往回滚立即回来
	const nav = document.querySelector<HTMLElement>(".nav")!;
	const install = nav.querySelector<HTMLButtonElement>(".install")!;
	const SOLID_AFTER = 0.6;
	const AWAY_AFTER = 0.8;
	const INSTALL_GAP = 6;
	const apply = (scroll: number, down: boolean) => {
		const solid = scroll > innerHeight * SOLID_AFTER;
		nav.toggleAttribute("data-scrolled", scroll > 0);
		nav.toggleAttribute("data-solid", solid);
		nav.toggleAttribute("data-away", down && scroll > innerHeight * AWAY_AFTER);
		install.inert = !solid;
	};
	// 安装按钮藏起时，其余链接右移它的宽度贴住右缘；按钮出现时链接平移让位，不触发重排
	new ResizeObserver(() => nav.style.setProperty("--install-w", `${install.offsetWidth + INSTALL_GAP}px`)).observe(install);
	const trigger = ScrollTrigger.create({ start: 0, end: "max", onUpdate: (self) => apply(self.scroll(), self.direction === 1) });
	apply(trigger.scroll(), false);
</script>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		/* 高度就是 --nav-h：钉住段按它让位 */
		height: var(--nav-h);
		/* 与区块内容同一左右边缘：限宽 page-max 居中，窄屏退回 gutter */
		padding-inline: max(var(--gutter), (100% - var(--page-max)) / 2);
		transition: translate 240ms var(--ease-enter);
		animation: nav-in 700ms 200ms var(--ease-enter) both;
	}

	/* 底色单独一层，只过渡 opacity */
	.nav::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: oklch(0.16 0.006 50 / 0.72);
		box-shadow: 0 1px 0 oklch(1 0 0 / 0.05);
		backdrop-filter: blur(14px) saturate(1.4);
		opacity: 0;
		transition: opacity 240ms var(--ease-enter);
	}

	.nav[data-solid]::before {
		opacity: 1;
	}

	.nav::after {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		z-index: -2;
		height: 96px;
		background: linear-gradient(var(--bg), transparent);
		pointer-events: none;
		opacity: 0;
		transition: opacity 240ms var(--ease-enter);
	}

	.nav[data-scrolled]::after {
		opacity: 1;
	}

	.nav[data-away]:not(:focus-within) {
		translate: 0 calc(-100% - 4px);
	}

	@keyframes nav-in {
		from {
			opacity: 0;
		}
	}

	.brand {
		display: block;
		padding: 6px;
		margin: -6px;
		border-radius: 10px;
	}

	.brand img {
		display: block;
		height: 26px;
		width: auto;
		transition: filter 240ms var(--ease-enter);
	}

	.links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.links a,
	.install {
		display: grid;
		place-items: center;
		min-width: 36px;
		height: 36px;
		padding: 0 10px;
		border-radius: 10px;
		color: var(--muted);
		font-size: 14px;
		font-weight: 500;
		transition:
			color var(--duration-state) var(--ease-enter),
			background-color var(--duration-state) var(--ease-enter),
			scale 100ms var(--ease-enter);
	}

	.links a {
		transition:
			color var(--duration-state) var(--ease-enter),
			background-color var(--duration-state) var(--ease-enter),
			scale 100ms var(--ease-enter),
			translate 240ms var(--ease-enter);
	}

	.nav:not([data-solid]) .links a {
		translate: var(--install-w, 0) 0;
	}

	.links a:active {
		scale: 0.94;
		background: var(--hover);
	}

	.links svg {
		width: 18px;
		height: 18px;
	}

	/* 安装按钮：导航变实底才出现；“已复制”与“安装”叠在同一格，宽度按较长的那个预留 */
	.install {
		margin-left: 6px;
		padding-inline: 14px;
		border: 0;
		background: var(--accent);
		color: var(--bg);
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
		opacity: 0;
		translate: 0 -4px;
		transition:
			opacity 240ms var(--ease-enter),
			translate 240ms var(--ease-enter),
			background-color var(--duration-state) var(--ease-enter),
			scale 100ms var(--ease-enter);
	}

	.nav[data-solid] .install {
		opacity: 1;
		translate: 0 0;
	}

	.install:active {
		scale: 0.94;
	}

	.label {
		grid-area: 1 / 1;
		transition: opacity var(--duration-state) var(--ease-enter);
	}

	.label.done,
	.install[data-state="done"] .label:not(.done) {
		opacity: 0;
	}

	.install[data-state="done"] .label.done {
		opacity: 1;
	}

	@media (hover: hover) and (pointer: fine) {
		.brand:hover img {
			filter: drop-shadow(0 0 10px oklch(0.72 0.19 50 / 0.55));
		}

		.links a:hover {
			color: var(--fg);
			background: var(--hover);
		}

		.install:hover {
			background: var(--accent-hot);
		}
	}

	@media (pointer: coarse) {
		.links a,
		.install {
			min-width: 44px;
			height: 44px;
		}
	}

	@media (max-width: 380px) {
		.brand img {
			height: 22px;
		}

		.links {
			gap: 0;
		}

		.install {
			margin-left: 2px;
		}
	}
</style>
