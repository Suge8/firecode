---
import "@fontsource-variable/mona-sans/wdth.css";
import "@fontsource/maple-mono/400.css";
import "../styles/global.css";
import iconUrl from "../../../design/brand/icon.svg?url";
import ogEn from "../../../design/promo/og-1280x640.png?url";
import ogZh from "../../../design/promo/og-1280x640.zh.png?url";
import { site, type Lang } from "../i18n";
import { tagline } from "../repo";
import Nav from "./Nav.astro";
import Hero from "../sections/Hero.astro";
import Agents from "../sections/Agents.astro";
import Review from "../sections/Review.astro";
import Core from "../sections/Core.astro";
import Closing from "../sections/Closing.astro";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = site[lang];
const description = tagline(lang).lede;
const canonical = new URL(t.home, Astro.site);
// 分享卡片复用仓库里的社交分享图，从本站同源提供
const ogImage = new URL(lang === "zh" ? ogZh : ogEn, Astro.site);
// 页面底色只在这里定：浏览器主题色与全局样式的 --bg 都取它，火焰着色器挂载时再从 --bg 读
const BG = "#0c0a09";
---

<!doctype html>
<html lang={t.tag} style={`--bg: ${BG}`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content={BG} />
		<link rel="icon" type="image/svg+xml" href={iconUrl} />
		<link rel="canonical" href={canonical} />
		{Object.values(site).map((s) => <link rel="alternate" hreflang={s.tag} href={new URL(s.home, Astro.site)} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(site.en.home, Astro.site)} />
		<link rel="alternate" type="text/markdown" href={new URL("index.md", canonical)} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={t.title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="FireCode" />
		<meta property="og:locale" content={t.ogLocale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<Nav lang={lang} />
		<main>
			<Hero lang={lang} />
			<Agents lang={lang} />
			<Review lang={lang} />
			<Core lang={lang} />
			<Closing lang={lang} />
		</main>
	</body>
</html>
