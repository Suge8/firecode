---
import filmEn from "../../../design/promo/flow.mp4?url";
import filmZh from "../../../design/promo/flow.zh.mp4?url";
import posterEn from "../../../design/promo/flow-poster.webp?url";
import posterZh from "../../../design/promo/flow-poster.zh.webp?url";
import PlayToggle from "../components/PlayToggle.astro";
import type { Lang } from "../i18n";
import { copy } from "./Film.copy";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const film = lang === "zh" ? filmZh : filmEn;
// 减少动效时停在指挥官终审的海报帧，不加载影片
const poster = lang === "zh" ? posterZh : posterEn;
---

<section class="section film" id="film" aria-labelledby="film-title">
	<div class="section-inner layout">
		<div class="copy">
			<h2 class="section-title" id="film-title">{t.title}</h2>
			<p class="section-lede">{t.lede}</p>
		</div>
		<figure class="reel">
			<div class="glow" aria-hidden="true"></div>
			<div class="frame">
				<video src={film} poster={poster} preload="none" muted playsinline loop width="1440" height="1920" aria-label={t.videoLabel}></video>
				<PlayToggle play={t.play} pause={t.pause} />
			</div>
		</figure>
	</div>
</section>

<script>
	import { gsap, reducedMotion } from "../scroll";
	import { controlVideo } from "../video";

	const root = document.querySelector<HTMLElement>("#film")!;
	controlVideo(root.querySelector("video")!, root.querySelector<HTMLButtonElement>(".play")!, { autoplay: () => true });

	if (!reducedMotion) {
		gsap.from(root.querySelectorAll(".copy > *, .reel"), {
			opacity: 0,
			y: 18,
			duration: 0.9,
			stagger: 0.08,
			ease: "expo.out",
			scrollTrigger: { trigger: root, start: "top 75%", once: true },
		});
	}
</script>

<style>
	/* 竖版 3:4：桌面端左文右片，片子高度不超过一屏（让出导航与上下留白）；窄屏改单栏，片子在文字下面 */
	.film {
		--reel-w: min(500px, calc((100svh - var(--nav-h) - 96px) * 3 / 4));

		overflow-x: clip;
	}

	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--reel-w);
		gap: clamp(40px, 7vw, 112px);
		align-items: center;
	}

	.reel {
		position: relative;
	}

	.glow {
		position: absolute;
		inset: 8% -18% -6%;
		z-index: -1;
		background: radial-gradient(closest-side, oklch(0.66 0.19 45 / 0.22), transparent);
		pointer-events: none;
	}

	/* 底色与影片一致，加载前不闪 */
	.frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: 3 / 4;
		border-radius: 18px;
		background: #111;
		box-shadow:
			0 0 0 1px var(--ring),
			0 40px 100px -32px oklch(0 0 0 / 0.85);
	}

	.frame video {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 860px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
			gap: clamp(32px, 6svh, 48px);
		}

		.reel {
			width: min(100%, 440px);
			justify-self: center;
		}
	}
</style>
