---
import markUrl from "../../../design/brand/mark.svg?url";
import Install from "../components/Install.astro";
import type { Lang } from "../i18n";
import { tagline } from "../repo";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const { headline, ledeLines } = tagline(lang);
---

<section class="hero" aria-labelledby="headline">
	<!-- 火焰加载期间（data-flame="loading"）藏起静态标志、闪光标；点燃后（"lit"）交给画布。
	     减少动效时不加载火焰；3 秒内没点燃（脚本被拦、网络太慢）就退回静态标志，火焰晚到仍会接手 -->
	<script is:inline>
		{
			const hero = document.currentScript.parentElement;
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
				hero.dataset.flame = "loading";
				setTimeout(() => hero.dataset.flame === "loading" && delete hero.dataset.flame, 3000);
			}
		}
	</script>
	<div class="flame-clip" aria-hidden="true"><canvas class="flame-canvas"></canvas></div>
	<div class="flame-box" data-mark={markUrl}>
		<img class="flame-static" src={markUrl} alt="" />
		<span class="cursor" aria-hidden="true"></span>
	</div>
	<div class="copy">
		<h1 id="headline" class="display">
			{headline.map((line, i) => <span class:list={["line", { dim: i > 0 }]}><span>{line}</span></span>)}
		</h1>
		<p class="lede">{ledeLines.map((sentence) => <span>{sentence} </span>)}</p>
		<Install lang={lang} class="hero-install" />
	</div>
</section>

<script>
	import { gsap, reducedMotion } from "../scroll";

	const hero = document.querySelector<HTMLElement>(".hero")!;
	const box = hero.querySelector<HTMLElement>(".flame-box")!;
	const canvas = hero.querySelector("canvas")!;

	// 往下滚时：文字先走（进度 0–0.35 淡出并轻微模糊），火焰以 0.35 倍速上移、原地缩小压暗（着色器里 0.1–0.4 熄灭），把视线交给下一屏
	const FLAME_LAG = 0.65;
	if (!reducedMotion) {
		let setFade = (_progress: number) => {};
		const exit = gsap
			.timeline({
				defaults: { ease: "none" },
				scrollTrigger: {
					trigger: hero,
					start: "top top",
					end: "bottom top",
					scrub: true,
					invalidateOnRefresh: true,
					onUpdate: (self) => setFade(self.progress),
				},
			})
			.to([canvas, box], { y: () => hero.offsetHeight * FLAME_LAG, duration: 1 }, 0)
			.to(hero.querySelector(".copy"), { opacity: 0, filter: "blur(8px)", duration: 0.35 }, 0);

		import("../flame/flame")
			.then(async ({ mountFlame }) => {
				const flame = await mountFlame({ canvas, box, markUrl: box.dataset.mark!, onIgnite: () => (hero.dataset.flame = "lit") });
				setFade = flame.setFade;
				setFade(exit.scrollTrigger!.progress);
			})
			.catch((error) => {
				console.error(error);
				delete hero.dataset.flame;
			});
	}
</script>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 96px var(--gutter) 72px;
		text-align: center;
	}

	/* 火焰滚动时比页面慢，会落到首屏下沿；这层在下沿渐隐，免得光晕被切出一条硬边 */
	.flame-clip {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		mask-image: linear-gradient(to top, transparent, #000 20%);
	}

	.flame-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.flame-box {
		position: relative;
		flex: none;
		height: clamp(160px, 30svh, 330px);
		aspect-ratio: 2916 / 3552;
		margin-top: 6svh;
	}

	.flame-static {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 0 48px oklch(0.7 0.2 45 / 0.35));
		transition: opacity 600ms var(--ease-enter);
	}

	[data-flame] .flame-static {
		opacity: 0;
	}

	/* 光标只在火焰加载期间闪；点燃时拉长淡出 */
	.cursor {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: clamp(10px, 1.1svh, 14px);
		height: clamp(18px, 2.2svh, 26px);
		translate: -50% 0;
		background: var(--accent);
		box-shadow: 0 0 18px var(--accent);
		opacity: 0;
		scale: 1 2.4;
		transition:
			opacity var(--duration-state) var(--ease-enter),
			scale var(--duration-state) var(--ease-enter);
	}

	[data-flame="loading"] .cursor {
		opacity: 1;
		scale: 1;
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 100%;
	}

	h1 {
		margin-top: clamp(28px, 5svh, 56px);
	}

	/* 入场不等火焰：页面一显示标题就升起 */
	.line > span {
		animation: rise-line 1100ms var(--ease-enter) both;
	}

	.line:first-child > span {
		animation-delay: 80ms;
	}

	.line + .line > span {
		animation-delay: 180ms;
	}

	.dim {
		color: oklch(0.74 0.02 60);
	}

	.lede {
		max-width: 40em;
		margin-top: 26px;
		color: var(--muted);
		font-size: var(--text-lede);
		line-height: 1.6;
		text-wrap: balance;
	}

	.lede > span {
		display: inline-block;
	}

	:global(:lang(zh)) .lede {
		max-width: 30em;
		line-height: 1.75;
	}

	:global(.hero-install) {
		margin-top: 36px;
		max-width: 100%;
	}

	.lede,
	.copy > :global(.hero-install) {
		animation: rise 900ms var(--ease-enter) both;
	}

	.lede {
		animation-delay: 260ms;
	}

	.copy > :global(.hero-install) {
		animation-delay: 340ms;
	}

	@keyframes rise-line {
		from {
			translate: 0 105%;
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			translate: 0 12px;
		}
	}

	/* 矮屏（如 1280×720）：火焰跟视口高度收小、各段间距收紧，安装框下方至少留 48px */
	@media (max-height: 760px) {
		.hero {
			padding-block: calc(var(--nav-h) + 8px) 48px;
		}

		.flame-box {
			height: clamp(140px, 27svh, 300px);
			margin-top: 0;
		}

		h1 {
			margin-top: 20px;
		}

		.lede {
			margin-top: 16px;
		}

		:global(.hero-install) {
			margin-top: 24px;
		}
	}

	@media (max-width: 480px) {
		.hero {
			padding-top: 88px;
		}

		.flame-box {
			height: clamp(150px, 26svh, 240px);
		}
	}
</style>
